# Database (local: npm run db:local → postgres/postgres @ localhost:5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rideshare?schema=public"

# NextAuth — в проде NEXTAUTH_URL = https://ваш-домен
NEXTAUTH_URL="http://localhost:3000"
# Сгенерируйте: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Mail.ru SMTP — подтверждение email при регистрации
EMAIL_SERVER_HOST="smtp.mail.ru"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="name@mail.ru"
EMAIL_SERVER_PASSWORD="пароль-приложения"
EMAIL_FROM="name@mail.ru"

# Секрет для очистки устаревших объявлений: /api/cron/cleanup
# Authorization: Bearer <secret>  или  ?secret=
CRON_SECRET="change-me-cron-secret"

# Google / VK OAuth — сейчас отключены в коде
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# VK_CLIENT_ID=""
# VK_CLIENT_SECRET=""
